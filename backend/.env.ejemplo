# Copia de ejemplo. El archivo real (.env) lo crea INSTALAR.bat con claves al azar.
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=root
DB_CLAVE=
DB_NOMBRE=agroestructuras
# Clave para firmar la sesión (cadena larga al azar)
SECRET_KEY=cambia-esto-por-una-cadena-larga-al-azar
# Código que se escribe al registrar la cuenta del dueño. Vacío = nadie puede registrarse como dueño.
CODIGO_DUENO=
PUERTO=5000
# --- Correo saliente (SMTP). Vacío = modo prueba: los correos se guardan en backend/correos_salida
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587, SMTP_USUARIO=tu_correo@gmail.com,
#        SMTP_CLAVE=contraseña de aplicación (no la normal): myaccount.google.com/apppasswords
URL_PUBLICA=http://localhost:5000
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_TLS=si
CORREO_REMITENTE=
NOMBRE_REMITENTE=AgroEstructuras
# A dónde llegan los avisos de solicitudes nuevas (vacío = correo de la cuenta del dueño). Varios: separados por coma
CORREO_AVISOS=
# ¿El correo al cliente lleva las cantidades de materiales?
CLIENTE_VE_CANTIDADES=si
